      },
      "conditions": [
        {
          "text": "证据重心是ImageNet的18/34层对应普通与残差网络；同深度保持参数、宽度及主体计算代价。CIFAR-10则补充极深模型的训练与测试边界。",
          "claim_refs": [
            "CR1",
            "CR4"
          ]
        }
      ],
      "assumptions": [
        {
          "text": "残差更容易优化是工作假设，并非单凭表达能力等价就能推出；恒等参照是否合适也依赖任务和网络结构。",
          "claim_refs": [
            "CR2"
          ]
        }
      ],
      "choices": [
        {
          "text": "使用相加恒等捷径，升维处比较补零与投影；为更深的ImageNet网络选择瓶颈以控制成本。加法后仍有ReLU，不能偷换成全网完全线性直通。",
          "claim_refs": [
            "CR2",
            "CR3"
          ]
        }
      ],
      "discriminating_evidence": [
