            "REL_HI"
          ],
          "evidence_refs": []
        },
        {
          "block_id": "A5",
          "markdown": "N_PREACT 把传播与泛化拆开。双恒等的展开式有明确条件，而完整预激活还改变 BN 的作用位置；某些模型训练损失略高却测试更好。后续行动应分别检验收敛困难和正则化，不能将所有改进归于唯一机制。",
          "paper_refs": [
            "P_RESNET",
            "P_HIGHWAY",
            "P_IDENTITY"
          ],
          "claim_refs": [
            "C_I2",
            "C_I3",
            "A_TEST"
          ],
          "node_refs": [
