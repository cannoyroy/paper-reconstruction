          "claim_refs": [
            "j1",
            "j2"
          ]
        }
      ],
      "assumptions": [
        {
          "text": "以失活突变体帮助区分结合和切割；失活突变不等于所有动力学均与野生型相同。",
          "claim_refs": [
            "j1",
            "j2"
          ]
        }
      ],
      "choices": [
        {
          "text": "组分恢复、催化域突变和PAM突变将“能切”拆为不同必要条件；再探索RNA结构融合。",
          "claim_refs": [
            "j1",
            "j2",
            "j4"
          ]
        }
      ],
      "discriminating_evidence": [
        {
          "text": "单个催化域失活与逐链标记支持链分工；PAM结合与切割读出支持PAM相关要求。",
          "claim_refs": [
            "j1",
            "j2"
          ]
        }
      ],
      "findings": [
        {
          "text": "建立可编程系统并提出PAM许可解链的解释；多轮结论在本次仅能作为正文报告保存。",
          "claim_refs": [
            "j2",
            "j3",
            "j4"
          ]
        }
      ],
      "limitations": [
