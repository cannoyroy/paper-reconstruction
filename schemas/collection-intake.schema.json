{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "stage",
    "goal",
    "user_clue",
    "provided_papers",
    "search"
  ],
  "properties": {
    "kind": {
      "const": "collection_intake",
      "type": "string"
    },
    "schema_version": {
      "const": "0.2.0",
      "type": "string"
    },
    "stage": {
      "anyOf": [
        {
          "const": "registered",
          "type": "string"
        },
        {
          "const": "awaiting_selection",
          "type": "string"
        },
        {
          "const": "frozen",
          "type": "string"
        }
      ]
    },
    "goal": {
      "minLength": 1,
      "type": "string"
    },
    "user_clue": {
      "minLength": 1,
      "type": "string"
    },
    "provided_papers": {
      "minItems": 2,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "authors",
          "identifier",
          "version",
          "domain",
          "research_type",
          "url",
          "paper_id",
          "work_id",
          "aliases",
          "origin",
          "candidate_id",
          "read_status",
          "material_note"
        ],
        "properties": {
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "authors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "minLength": 1,
              "type": "string"
            }
          },
          "identifier": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          },
          "domain": {
            "minLength": 1,
            "type": "string"
          },
          "research_type": {
            "anyOf": [
              {
                "const": "computational",
                "type": "string"
              },
              {
                "const": "experimental",
                "type": "string"
              },
              {
                "const": "observational",
                "type": "string"
              },
              {
                "const": "theoretical",
                "type": "string"
              },
              {
                "const": "mixed",
                "type": "string"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "paper_id": {
            "minLength": 1,
            "type": "string"
          },
          "work_id": {
            "minLength": 1,
            "type": "string"
          },
          "aliases": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "minLength": 1,
              "type": "string"
            }
          },
          "origin": {
            "anyOf": [
              {
                "const": "provided",
                "type": "string"
              },
              {
                "const": "accepted_recommendation",
                "type": "string"
              }
            ]
          },
          "candidate_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "read_status": {
            "anyOf": [
              {
                "const": "read",
                "type": "string"
              },
              {
                "const": "partial",
                "type": "string"
              },
              {
                "const": "unavailable",
                "type": "string"
              }
            ]
          },
          "material_note": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "search": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status",
        "queries",
        "note",
        "candidates"
      ],
      "properties": {
        "status": {
          "anyOf": [
            {
              "const": "not_started",
              "type": "string"
            },
            {
              "const": "provided_only",
              "type": "string"
            },
            {
              "const": "completed",
              "type": "string"
            },
            {
              "const": "unavailable",
              "type": "string"
            }
          ]
        },
        "queries": {
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "note": {
          "minLength": 1,
          "type": "string"
        },
        "candidates": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "candidate_id",
              "work_id",
              "title",
              "authors",
              "year",
              "version",
              "url",
              "related_paper_refs",
              "gap",
              "expected_change",
              "inspected_material",
              "full_text_status",
              "decision",
              "decision_record",
              "decision_source"
            ],
            "properties": {
              "candidate_id": {
                "minLength": 1,
                "type": "string"
              },
              "work_id": {
                "minLength": 1,
                "type": "string"
              },
              "title": {
                "minLength": 1,
                "type": "string"
              },
              "authors": {
                "uniqueItems": true,
                "minItems": 1,
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "year": {
                "anyOf": [
                  {
                    "minimum": 1500,
                    "maximum": 3000,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version": {
                "minLength": 1,
                "type": "string"
              },
              "url": {
                "minLength": 1,
                "type": "string"
              },
              "related_paper_refs": {
                "uniqueItems": true,
                "minItems": 1,
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "gap": {
                "minLength": 1,
                "type": "string"
              },
              "expected_change": {
                "minLength": 1,
                "type": "string"
              },
              "inspected_material": {
                "minLength": 1,
                "type": "string"
              },
              "full_text_status": {
                "anyOf": [
                  {
                    "const": "available",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  },
                  {
                    "const": "unavailable",
                    "type": "string"
                  }
                ]
              },
              "decision": {
                "anyOf": [
                  {
                    "const": "pending",
                    "type": "string"
                  },
                  {
                    "const": "accepted",
                    "type": "string"
                  },
                  {
                    "const": "rejected",
                    "type": "string"
                  }
                ]
              },
              "decision_record": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "decision_source": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "const": "user",
                        "type": "string"
                      },
                      {
                        "const": "simulated_test",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
